# Explicit opt-in to one potentially chargeable SMS reply.
HAIL_E2E_CONFIRM=send-one-sms
HAIL_FROM_NUMBER=
HAIL_E2E_PEER_NUMBER=
# Your ngrok/test tunnel HTTPS origin, forwarding to localhost:8787.
HAIL_E2E_PUBLIC_URL=
HAIL_E2E_PORT=8787
# Optional. Otherwise reuse the Hail CLI credential file, without printing its key.
HAIL_API_KEY=
HAIL_API_URL=https://api.hail.so
