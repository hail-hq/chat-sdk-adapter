HAIL_API_KEY=
HAIL_FROM_NUMBER=
HAIL_WEBHOOK_SECRET=
# Set true only when you attest to the required consent for every recipient.
HAIL_RECIPIENT_CONSENT=false
# Optional self-hosted API origin, without /v1.
HAIL_API_URL=https://api.hail.so
# This example uses Redis for shared Chat SDK state in production.
# This is a state-backend choice, not a Hail API requirement.
# Without it, development uses process-local memory.
REDIS_URL=
